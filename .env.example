FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# PostgreSQL
DATABASE_URL=postgresql://scrapemind:scrapemind@localhost:5432/scrapemind

# Redis (Faz 2 — Celery)
REDIS_URL=redis://localhost:6379/0

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Flask-Limiter storage
RATELIMIT_STORAGE_URL=memory://

# Email — MAIL_SERVER bos kalirsa dev modu (link flash'ta gosterilir).
# MAIL_USE_TLS (587/STARTTLS) ve MAIL_USE_SSL (465) ayni anda true OLMAMALI.
# MAIL_SUPPRESS_SEND'i bos birak (otomatik: MAIL_SERVER varsa gonder, yoksa suppress).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@scrapemind.local
MAIL_SUPPRESS_SEND=

# --- Email yapilandirma ornekleri (yorum acip uyarla) ---
#
# 1) Mailhog (lokal dev — hicbir email gercek hedefe ulasmaz, http://localhost:8025'ten oku)
#    `docker compose --profile mail up -d` ile baslat.
# MAIL_SERVER=localhost
# MAIL_PORT=1025
# MAIL_USE_TLS=false
# MAIL_USE_SSL=false
# MAIL_USERNAME=
# MAIL_PASSWORD=
#
# 2) Gmail / Google Workspace (uygulamaya ozel sifre gerekli)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USE_TLS=false
# MAIL_USE_SSL=true
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=<app-password>
#
# 3) Resend (https://resend.com — SMTP relay)
# MAIL_SERVER=smtp.resend.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=resend
# MAIL_PASSWORD=<RESEND_API_KEY>
#
# 4) Amazon SES (region'a gore endpoint degisir)
# MAIL_SERVER=email-smtp.eu-west-1.amazonaws.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=<SES_SMTP_USER>
# MAIL_PASSWORD=<SES_SMTP_PASSWORD>

# i18n
BABEL_DEFAULT_LOCALE=tr
BABEL_DEFAULT_TIMEZONE=Europe/Istanbul

# Anthropic Claude — paper AI analiz + TR ceviri.
# Bos kalirsa /papers/<id>?mode=ai zarif bir "yapilandirilmadi" paneli gosterir;
# uygulama crash etmez. Anahtarli sahip oldugun an feature aktif olur.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# LLM saglayici soyutlamasi (Faz 1 — gunluk/haftalik brifing).
# "openrouter" (varsayilan, ucretsiz ":free" modelleri var) | "ollama" (yerel,
# key gerekmez) | "anthropic" (yukaridaki ANTHROPIC_* kullanilir).
LLM_PROVIDER=openrouter

# OpenRouter — https://openrouter.ai/keys (ucretsiz key alinabilir).
# OPENROUTER_API_KEY global fallback'tir; kullanicilar profil > AI Settings
# sekmesinden kendi key'lerini girebilir (kendi key'leri varsa o kullanilir).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct:free

# Ollama — yerelde calisan, key gerektirmeyen alternatif.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5

# Per-user LLM API key'lerini sifrelemek icin Fernet anahtari (base64, 32 byte).
# Bos birakilirsa SECRET_KEY'den turetilir (sha256 -> urlsafe base64) — dev/test
# icin yeterli; production'da ayri bir deger vermen onerilir.
LLM_ENC_KEY=

# API v1 (JWT) — bkz. docs/API_V1.md.
# JWT_SECRET_KEY bos birakilirsa SECRET_KEY kullanilir; API token'larini web
# session'larindan bagimsiz dondurmek (rotate) icin ayri bir deger ver.
JWT_SECRET_KEY=
JWT_ISSUER=scrapemind
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Audit log retention — bu gunden eski kayitlar geceleri otomatik silinir.
# 0 = kapali (sonsuza kadar sakla).
AUDIT_RETENTION_DAYS=180

# Redis cache (RBAC izin setleri). Sadece hizlandirma amacli: false yaparsan
# veya Redis erisilemezse uygulama dogrudan Postgres'ten okur, calismaya devam
# eder. REDIS_URL yukarida (Celery ile ayni instance).
CACHE_ENABLED=true
CACHE_TTL=300

# Scraping source'lari (virgullu liste). Varsayilan: hepsi (akademik
# adaptorler + RSS sektor kaynaklari — bkz. app/modules/scrape/sources/rss_source.py).
# Ornek: sadece arXiv icin SCRAPE_SOURCES=arxiv
SCRAPE_SOURCES=arxiv,semantic_scholar,pubmed,openalex,crossref,youtube_reach,github_reach,web_reach,openai_blog,google_ai_blog,deepmind_blog,huggingface_blog
# Opsiyonel API anahtarlari — bos birakilirsa paylasimli (rate-limitli)
# anonim kota kullanilir. Anahtar almak ucretsiz:
#   Semantic Scholar: https://www.semanticscholar.org/product/api
#   NCBI (PubMed):    https://www.ncbi.nlm.nih.gov/account/settings/
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=
# OpenAlex anahtar gerektirmez (tamamen acik). Bir iletisim adresi verirsen
# "polite pool"a girersin (daha hizli/istikrarli yanit) — bos birakilirse
# paylasimli anonim havuz kullanilir. Ornek: OPENALEX_MAILTO=you@example.com
OPENALEX_MAILTO=
# Crossref de anahtar gerektirmez, ayni "polite pool" mantigi OpenAlex'teki
# gibi calisir — bos birakilirse paylasimli anonim havuz kullanilir.
# Ornek: CROSSREF_MAILTO=you@example.com
CROSSREF_MAILTO=

# Tarama gecmisi — ScanRun kayitlari bu gunden eskiyse gecelik purge task'i
# siler. 0 = kapali (sonsuza kadar sakla).
SCAN_RUN_RETENTION_DAYS=30

# Gecelik fan-out'un kullanicilari yaydigi pencere (saniye). Tum kullanicilari
# ayni anda kuyruga atmak yerine kullanici ID'sinden turetilen deterministik bir
# offset kullanilir — boylece her kullanicinin taranma dakikasi sabit kalir ve
# arayuzde gosterilen "sonraki tarama" saati gercekten dogru olur.
SCAN_FANOUT_WINDOW_SECONDS=1800

# Celery task sure limitleri (saniye). soft = SoftTimeLimitExceeded firlatir,
# hard = worker child'i oldurur. Askida kalan bir HTTP cagrisinin bir worker
# slot'unu sonsuza kadar isgal etmesini engeller.
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_TIME_LIMIT=900

# Kullanici basina eklenebilecek ozel RSS feed sayisi. Her aktif feed gecelik
# taramada bir HTTP istegi demek — asil maliyet dugmesi budur.
MAX_USER_FEEDS=50

# Feed cekme: okuma timeout'u (saniye) ve govde ust siniri (byte).
FEED_FETCH_TIMEOUT=15
FEED_FETCH_MAX_BYTES=5242880

# SSRF korumasi kacis kapisi. Sadece localhost'ta servis edilen bir feed ile
# gelistirme yaparken true yap — production'da ASLA acma.
FEED_ALLOW_PRIVATE_HOSTS=false

# Paylasimli dis API kotalari (deployment geneli, Redis uzerinden uygulanir).
# Adapter'larin kendi client-side throttle'i sadece tek bir process icin gecerli;
# es zamanli worker sayisi kadar carpilmasini bunlar engeller.
SCRAPE_RATE_ARXIV_PER_MIN=20
SCRAPE_RATE_S2_PER_5MIN=100
SCRAPE_RATE_PUBMED_PER_SEC=3
SCRAPE_RATE_OPENALEX_PER_SEC=8
SCRAPE_RATE_CROSSREF_PER_SEC=5
# Agent Reach adaptorleri (web/youtube/github) icin — daha once BaseConfig'te
# tanimli degildi, sadece kod-ici fallback'e dusuyordu.
SCRAPE_RATE_WEB_PER_MIN=30
SCRAPE_RATE_YOUTUBE_PER_MIN=30
SCRAPE_RATE_GITHUB_PER_MIN=30

# Observability — ikisi de opsiyonel. SENTRY_DSN bos = Sentry kapali.
# METRICS_ENABLED=true -> /metrics (Prometheus). Uyari: endpoint auth'suzdur;
# production'da nginx uzerinden disari acma (bkz. docs/DEPLOYMENT.md).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
METRICS_ENABLED=false
