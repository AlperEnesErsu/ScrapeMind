FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# PostgreSQL
DATABASE_URL=postgresql://scrapemind:scrapemind@localhost:5432/scrapemind

# Redis (Faz 2 — Celery)
REDIS_URL=redis://localhost:6379/0

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Flask-Limiter storage
RATELIMIT_STORAGE_URL=memory://

# Email — MAIL_SERVER bos kalirsa dev modu (link flash'ta gosterilir).
# MAIL_USE_TLS (587/STARTTLS) ve MAIL_USE_SSL (465) ayni anda true OLMAMALI.
# MAIL_SUPPRESS_SEND'i bos birak (otomatik: MAIL_SERVER varsa gonder, yoksa suppress).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@scrapemind.local
MAIL_SUPPRESS_SEND=

# --- Email yapilandirma ornekleri (yorum acip uyarla) ---
#
# 1) Mailhog (lokal dev — hicbir email gercek hedefe ulasmaz, http://localhost:8025'ten oku)
#    `docker compose --profile mail up -d` ile baslat.
# MAIL_SERVER=localhost
# MAIL_PORT=1025
# MAIL_USE_TLS=false
# MAIL_USE_SSL=false
# MAIL_USERNAME=
# MAIL_PASSWORD=
#
# 2) Gmail / Google Workspace (uygulamaya ozel sifre gerekli)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USE_TLS=false
# MAIL_USE_SSL=true
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=<app-password>
#
# 3) Resend (https://resend.com — SMTP relay)
# MAIL_SERVER=smtp.resend.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=resend
# MAIL_PASSWORD=<RESEND_API_KEY>
#
# 4) Amazon SES (region'a gore endpoint degisir)
# MAIL_SERVER=email-smtp.eu-west-1.amazonaws.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=<SES_SMTP_USER>
# MAIL_PASSWORD=<SES_SMTP_PASSWORD>

# i18n
BABEL_DEFAULT_LOCALE=tr
BABEL_DEFAULT_TIMEZONE=Europe/Istanbul

# Anthropic Claude — paper AI analiz + TR ceviri.
# Bos kalirsa /papers/<id>?mode=ai zarif bir "yapilandirilmadi" paneli gosterir;
# uygulama crash etmez. Anahtarli sahip oldugun an feature aktif olur.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# API v1 (JWT) — bkz. docs/API_V1.md.
# JWT_SECRET_KEY bos birakilirsa SECRET_KEY kullanilir; API token'larini web
# session'larindan bagimsiz dondurmek (rotate) icin ayri bir deger ver.
JWT_SECRET_KEY=
JWT_ISSUER=scrapemind
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Audit log retention — bu gunden eski kayitlar geceleri otomatik silinir.
# 0 = kapali (sonsuza kadar sakla).
AUDIT_RETENTION_DAYS=180

# Redis cache (RBAC izin setleri). Sadece hizlandirma amacli: false yaparsan
# veya Redis erisilemezse uygulama dogrudan Postgres'ten okur, calismaya devam
# eder. REDIS_URL yukarida (Celery ile ayni instance).
CACHE_ENABLED=true
CACHE_TTL=300

# Scraping source'lari (virgullu liste). Varsayilan: hepsi.
# Ornek: sadece arXiv icin SCRAPE_SOURCES=arxiv
SCRAPE_SOURCES=arxiv,semantic_scholar,pubmed
# Opsiyonel API anahtarlari — bos birakilirsa paylasimli (rate-limitli)
# anonim kota kullanilir. Anahtar almak ucretsiz:
#   Semantic Scholar: https://www.semanticscholar.org/product/api
#   NCBI (PubMed):    https://www.ncbi.nlm.nih.gov/account/settings/
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=
