# Production environment template — copy to .env.prod and fill in.
# .env.prod is gitignored; NEVER commit real values.
#
#   cp .env.prod.example .env.prod
#   python -c "import secrets; print(secrets.token_hex(32))"   # generate keys
#
# The app REFUSES to start in production with an empty SECRET_KEY or
# DATABASE_URL (fail-fast guard in app/__init__.py).

FLASK_ENV=production
FLASK_APP=wsgi.py

# --- Secrets (generate fresh, never reuse dev values) ---
SECRET_KEY=
# Optional: separate signing key for API tokens so they can be rotated
# independently of web sessions. Falls back to SECRET_KEY when empty.
JWT_SECRET_KEY=

# --- Database (used by docker-compose.prod.yml for both Postgres and the app) ---
POSTGRES_USER=scrapemind
POSTGRES_PASSWORD=
POSTGRES_DB=scrapemind

# --- Email (real SMTP; see .env.example for provider examples) ---
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@example.com

# --- OAuth (leave empty to disable a provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --- AI features (empty = feature shows a "configure to enable" panel) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Scraping ---
SCRAPE_SOURCES=arxiv,semantic_scholar,pubmed
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=

# --- Ops ---
AUDIT_RETENTION_DAYS=180
CACHE_ENABLED=true
CACHE_TTL=300
RATELIMIT_STORAGE_URL=redis://redis:6379/1

# --- i18n ---
BABEL_DEFAULT_LOCALE=tr
BABEL_DEFAULT_TIMEZONE=Europe/Istanbul
