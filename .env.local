# Yerel geliştirme — Postgres ScrapeMind'in kendi container'i (5433),
# Redis paylaşımlı (myoChtBt'nin shared_redis'i, 6379).
# Kopyala: copy .env.local.example .env.local
# development.bat bu dosyayı .env'e kopyalar.

FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=local-dev-secret-change-me

# ScrapeMind'in kendi Postgres'i (pgvector/pgvector:pg17), 5433'te.
# Paylasimli myo_postgres17 pgvector saglamiyor - bkz. docs/HANDOVER.md 4.9.
# Ayaga kaldir: SCRAPEMIND_DB_PORT=5433 docker compose \
#   -f docker/docker-compose.yml -p scrapemind up -d db
DATABASE_URL=postgresql://scrapemind:scrapemind@localhost:5433/scrapemind

# myoChtBt docker-compose.override.yml tarafından başlatılan Redis
REDIS_URL=redis://localhost:6379/1

BABEL_DEFAULT_LOCALE=tr
BABEL_DEFAULT_TIMEZONE=Europe/Istanbul
RATELIMIT_STORAGE_URL=redis://localhost:6379/2

# Testler ayri veritabaninda. ZORUNLU: yoksa create_app() TestingConfig
# default'una baglanir ve butun paket psycopg2.OperationalError verir.
TEST_DATABASE_URL=postgresql://scrapemind:scrapemind@localhost:5433/scrapemind_test
